rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function ownsEvent(eventId) {
      return signedIn() && (
        get(/databases/$(database)/documents/events/$(eventId)).data.userId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.collaborators
      );
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId || isAdmin();
    }
    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if ownsEvent(eventId) || isAdmin();
      match /{subcollection}/{itemId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/events/$(eventId))
          && subcollection in ['photos', 'videos', 'guestbook', 'audioGuestbook', 'musicRequests'];
        allow update, delete: if ownsEvent(eventId) || isAdmin();
      }
    }
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /stripeWebhookEvents/{eventId} { allow read, write: if false; }
  }
}
